# Claude Code -> local model configuration. Copied to .env on first `dco` run.
# Edit .env (gitignored); this file is the committed template.
# Reference: https://code.claude.com/docs/en/env-vars
#
# These are injected into the `claude-local` service only. The `dcc` service
# never sees this file, so it keeps talking to Anthropic with your account.

# ---- Endpoint --------------------------------------------------------------
# The endpoint must serve the Anthropic /v1/messages shape. Many gateways serve
# it alongside the OpenAI shape on the same host and port, so an endpoint you
# reached as OPENAI_BASE_URL=http://host:8000/v1 is usually http://host:8000
# here. If yours is OpenAI-only, front it with an Anthropic-compatible shim.
#
# Host and port ONLY -- no trailing /v1. Claude Code appends the path, so a
# base URL ending in /v1 produces /v1/v1/messages and 404s.
#
# `localhost` inside the container is the container itself. If the endpoint is
# an SSH forward on the Docker host, use host.docker.internal (see README):
ANTHROPIC_BASE_URL=http://host.docker.internal:8000
# ...or address the server directly if it is reachable over the network:
#ANTHROPIC_BASE_URL=https://llm.internal.example

# Sent as the `Authorization: Bearer <value>` header. Set it even if your
# endpoint ignores auth: without a credential Claude Code falls back to your
# Anthropic subscription login and sends *that* to your proxy. Prefer this over
# ANTHROPIC_API_KEY, which additionally triggers a one-time approval prompt.
ANTHROPIC_AUTH_TOKEN=dummy

# ---- Model aliases ---------------------------------------------------------
# Set ALL of these to your local model. Each Claude Code alias resolves
# independently, and HAIKU is not optional: it backs background work (session
# titles, summaries), so leaving it unset makes Claude Code request a real
# Anthropic Haiku ID your endpoint has never heard of.
ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3.8
ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.8
ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.8

# Model new sessions start on (needs Claude Code >= 2.1.236). Without it a
# session opens on whichever alias was last selected.
ANTHROPIC_DEFAULT_MODEL=qwen3.8

# Subagent model. Defaults to the main model; set it to use a cheaper one.
#CLAUDE_CODE_SUBAGENT_MODEL=qwen3.8

# Adds a literal model ID to the /model picker, so you can switch to it by its
# real name instead of going through an alias.
#ANTHROPIC_CUSTOM_MODEL_OPTION=qwen3.8

# Populate the /model picker from the gateway's own model list. Exempt from
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC below, since it only queries your
# endpoint -- no external egress. Useful if the gateway serves several models.
#CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

# ---- Reasoning effort ------------------------------------------------------
# Claude Code defaults to `high`, which some gateways reject outright:
#   400 Unexpected reasoning effort high. Supported types are xhigh
#   (default), medium, and low.
# This pins the level for the session. Claude Code accepts low | medium |
# high | xhigh; use one your endpoint also accepts. `xhigh` suits coding and
# agentic work; drop to medium or low if local inference is too slow.
CLAUDE_CODE_EFFORT_LEVEL=xhigh

# ---- Tuning for local inference --------------------------------------------
# Request deadline in ms (default 600000 = 10 min). Raise for slow local
# inference; max 2147483647, and values above it fail immediately.
#API_TIMEOUT_MS=1800000

# Cap Claude Code's requested output tokens. Lower it if your model has a
# small context window and requests get rejected for exceeding it.
#CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192

#MAX_THINKING_TOKENS=4096

# Extra headers, "Name: Value", newline-separated for multiple.
#ANTHROPIC_CUSTOM_HEADERS=X-Tenant: research

# Claude Code disables MCP tool search on a non-first-party base URL. Re-enable
# only if your proxy forwards `tool_reference` blocks.
#ENABLE_TOOL_SEARCH=true

# ---- Telemetry and updates -------------------------------------------------
# These turn off reporting while leaving Claude Code's auto-updater working, so
# dco keeps itself current the same way a host install does.
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1

# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC is the bigger hammer: it puts Claude
# Code in "essential-traffic" mode, which ALSO suppresses the update check, so
# the version baked into the image becomes the only version you ever run. Set it
# only if you want egress limited to your endpoint and accept updating by
# rebuilding the image (docker compose build --no-cache).
#CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
#DISABLE_AUTOUPDATER=1
#DISABLE_BUG_COMMAND=1

# ---- Docker networking (used at `docker compose` time, not in the container)-
# Set to the tunnel's MTU when the endpoint is reached over WireGuard, otherwise
# large requests stall while small ones succeed. Find it with: ip link show wg0
#DOCKER_MTU=1420

# Address host.docker.internal should point at. Leave unset to use Docker's
# host-gateway (the docker0 bridge, 172.17.0.1) — override when that interface
# is down, which it is whenever nothing uses the default bridge network:
#   docker network inspect dco_default -f '{{(index .IPAM.Config 0).Gateway}}'
#HOST_GATEWAY=172.19.0.1

# Subnet collisions with networks behind the tunnel are a daemon-level concern:
# set default-address-pools in /etc/docker/daemon.json. See the README.
